# Shopify — client credentials (server-side only; never VITE_*)
# https://shopify.dev/docs/apps/build/authentication-authorization/access-tokens/client-credentials-grant
SHOPIFY_SHOP_DOMAIN=storefront-api-m8i5h3yi.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Storefront GraphQL API version (quarterly releases): https://shopify.dev/docs/api/storefront
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# Optional: force mock catalog in the browser. By default the app now uses Shopify
# in both dev and production, as long as `/api/storefront` is available.
# VITE_ENABLE_MOCK_CATALOG=true

# Dev proxy: OAuth token from client_credentials is sent as Shopify-Storefront-Private-Token
# (not X-Shopify-Storefront-Access-Token, which is for Headless *public* tokens only).

# Homepage PDP links use this handle when using Shopify (must exist in the store).
VITE_DEFAULT_PRODUCT_HANDLE=kinetik-v1

# Checkout uses the same /api/storefront proxy + OAuth token as catalog (no separate browser token).
# On Vercel, add SHOPIFY_SHOP_DOMAIN / SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET /
# SHOPIFY_STOREFRONT_API_VERSION as project environment variables.

# Optional aliases (no spaces around =)
# CLIENT_ID=
# CLIENT_SECRET=
